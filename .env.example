# VibeWindow Environment Variables
# Copy this file to `.env` and fill in your local values.
# Never commit `.env` or any real secrets.

# ── Core Runtime ──────────────────────────────────────────────
# Provider key resolution at runtime:
# 1) explicit key passed from config/CLI
# 2) provider-specific env var (OPENROUTER_API_KEY, OPENAI_API_KEY, ...)
# 3) generic fallback env vars below

# Generic fallback API key (used when provider-specific key is absent)
API_KEY=your-api-key-here
# VIBEWINDOW_API_KEY=your-api-key-here

# Default provider/model (can be overridden by CLI flags)
PROVIDER=openrouter
# VIBEWINDOW_PROVIDER=openrouter
# VIBEWINDOW_MODEL=anthropic/claude-sonnet-4-6
# VIBEWINDOW_TEMPERATURE=0.7

# Workspace directory override
# VIBEWINDOW_WORKSPACE=/path/to/workspace

# Reasoning mode (enables extended thinking for supported models)
# VIBEWINDOW_REASONING_ENABLED=false
# REASONING_ENABLED=false

# ── Provider-Specific API Keys ────────────────────────────────
# OpenRouter
# OPENROUTER_API_KEY=sk-or-v1-...

# Anthropic
# ANTHROPIC_OAUTH_TOKEN=...
# ANTHROPIC_API_KEY=sk-ant-...

# OpenAI / Gemini
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=...
# GOOGLE_API_KEY=...

# Other supported providers
# VENICE_API_KEY=...
# GROQ_API_KEY=...
# MISTRAL_API_KEY=...
# DEEPSEEK_API_KEY=...
# XAI_API_KEY=...
# TOGETHER_API_KEY=...
# FIREWORKS_API_KEY=...
# PERPLEXITY_API_KEY=...
# COHERE_API_KEY=...
# MOONSHOT_API_KEY=...
# GLM_API_KEY=...
# MINIMAX_OAUTH_TOKEN=...
# MINIMAX_API_KEY=...
# MINIMAX_OAUTH_REFRESH_TOKEN=...
# MINIMAX_OAUTH_REGION=global   # optional: global|cn
# QIANFAN_API_KEY=...
# DASHSCOPE_API_KEY=...
# ZAI_API_KEY=...
# SYNTHETIC_API_KEY=...
# OPENCODE_API_KEY=...
# VERCEL_API_KEY=...
# CLOUDFLARE_API_KEY=...

# ── Gateway ──────────────────────────────────────────────────
# VIBEWINDOW_GATEWAY_PORT=3000
# VIBEWINDOW_GATEWAY_HOST=127.0.0.1
# VIBEWINDOW_ALLOW_PUBLIC_BIND=false

# ── Storage ─────────────────────────────────────────────────
# Global shared database backend is selected by database/config.json.
# Missing config defaults to SQLite. PostgreSQL reads its URL only from this env var;
# use sslmode=require for verified TLS, or sslmode=disable only for trusted local tests.
# VIBEWINDOW_DATABASE_URL=postgres://your_db_user:your_db_password@127.0.0.1:5432/vibe-window?sslmode=require

# Local PostgreSQL test fixture. Never point this at a production/business database.
# The fixture creates and drops only random vw_test_<uuid> schemas after a prefix guard.
# VIBEWINDOW_TEST_POSTGRES_URL=postgres://your_db_user:your_db_password@127.0.0.1:5432/vibe-window?sslmode=disable
# Local test profile: MaxIdleConns=10 is an unmapped baseline (r2d2 has no max-idle cap);
# MaxOpenConns=100 -> r2d2.max_size; MaxLifetime=300s -> r2d2.max_lifetime;
# Debug=false -> SQL debug logging remains disabled.

# Independent persistent-storage backend; this does not select the global shared database.
# Backend override for persistent storage (default: sqlite)
# VIBEWINDOW_STORAGE_PROVIDER=sqlite
# VIBEWINDOW_STORAGE_DB_URL=postgres://localhost/vibewindow
# VIBEWINDOW_STORAGE_CONNECT_TIMEOUT_SECS=5

# ── Proxy ──────────────────────────────────────────────────
# Forward provider/service traffic through an HTTP(S) proxy.
# VIBEWINDOW_PROXY_ENABLED=false
# VIBEWINDOW_HTTP_PROXY=http://proxy.example.com:8080
# VIBEWINDOW_HTTPS_PROXY=http://proxy.example.com:8080
# VIBEWINDOW_ALL_PROXY=socks5://proxy.example.com:1080
# VIBEWINDOW_NO_PROXY=localhost,127.0.0.1
# VIBEWINDOW_PROXY_SCOPE=vibewindow          # environment|vibewindow|services
# VIBEWINDOW_PROXY_SERVICES=openai,anthropic

# ── Docker Compose ───────────────────────────────────────────
# Host port mapping (used by docker-compose.yml)
# HOST_PORT=3000

# Or set the environment variable:
# ZAI_API_KEY=your-id.secret
#
# Common models: glm-5, glm-4.7, glm-4-plus, glm-4-flash
# See docs/zai-glm-setup.md for detailed configuration.

# ── Web Search ────────────────────────────────────────────────
# Web search tool for finding information on the internet.
# Enabled by default with DuckDuckGo (free, no API key required).
#
# WEB_SEARCH_ENABLED=true
# WEB_SEARCH_PROVIDER=duckduckgo
# WEB_SEARCH_MAX_RESULTS=5
# WEB_SEARCH_TIMEOUT_SECS=15
#
# Optional: Brave Search (requires API key from https://brave.com/search/api)
# WEB_SEARCH_PROVIDER=brave
# BRAVE_API_KEY=your-brave-search-api-key

DIFY_API_KEY=
DIFY_API_BASE_URL=https://api.dify.ai
