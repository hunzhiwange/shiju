{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "printf a >> \"$PLUGIN_DATA/result\""
          }
        ]
      },
      {
        "matcher": "^Write$",
        "hooks": [
          {
            "type": "command",
            "command": "printf b >> \"$PLUGIN_DATA/result\""
          },
          {
            "type": "command",
            "command": "printf b >> \"$PLUGIN_DATA/result\""
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "printf x >> \"$PLUGIN_DATA/result\""
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "printf c >> \"$PLUGIN_DATA/result\""
          }
        ]
      }
    ]
  }
}
