  "package_integrity": {
    "test": "codex_plugin_compat_t13_invokes_onboarding_only_on_request",
    "fixture_input_sha256": {
      ".codex-plugin/plugin.json": "387e74b8035c2341820c150699981ad39d2c3bd7391912c82fa8d1ee9f9da24f",
      "skills/setup/SKILL.md": "0d3c08a996df02eb13517f9af1373ec1f239f6bce6ae4580113d7bb31bdf6a9f",
      "skills/setup/resources/guide.txt": "9d7423c39604dcd320cf3aad132168cd5659a3473be439dd63940326b9babcac",
      "skills/setup/scripts/setup.sh": "e28cd32a70717842a8c81b7811e2f5bc8621277082d1068ba6a55aceddc4fd5d"
    },
    "basis": "The real test hashes all original files before installation, checks source and installed snapshots after display and ordinary explicit invocation, and asserts equality. These hashes are computed from the fixed fixture inputs; no raw user package data is recorded."
  },
  "observed_side_effects": [
    "Install output offers only the exact qualified ordinary skill entry and leaves all invocation records empty; bundled scripts never run during install or invocation loading.",
    "Explicit SkillTool invocation expands supplied arguments, resolves the original package resource directory and records the exact plugin/marketplace identity through the existing runtime.",
    "Legacy alternatives and both portable extension locations accept paths with and without ./; an inline namespace replaces the full legacy overlay.",
    "A contained file or directory, undeclared skill root, duplicate-name loser, shadowing installation, disabled plugin, security-rejected skill or user-invocable=false cannot become an onboarding entry.",
    "Local skill priority and ordinary invocation alias ambiguity are checked against the exact final SkillTool inventory; onboarding cannot advertise a hidden or ambiguous plugin entry. A previously shown entry cannot bypass later plugin disablement. Path reauditing refuses symlink mutation without reading outside the package."
  ],
  "intentional_safety_differences": [
    "The reference resolves an onboarding path only when it equals an admitted plugin skill entry. The host follows that membership rule and additionally retains its existing symlink/path audit restrictions.",
    "Invalid or currently unavailable onboarding does not undo a successfully installed package: CLI reports Onboarding unavailable rather than exposing a false entry. Existing ordinary skill permissions and explicit-user policies remain authoritative."
