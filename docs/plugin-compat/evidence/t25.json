  "source_review": {
    "routing": "Gateway forms router registered in both production factories. Authenticated tenant, canonical workspace and session bind a random UI-only host capability, with idle expiry and cleanup. Replies remain independent from the busy MCP peer mutex.",
    "ui": "Production chat stream opens host only after request validation. Production App update/view/escape use the same ephemeral draft and source-bound reply path. Shared settings styles/modal/toast, 4px scrollbar and 7px gutters. No non-ASCII monospace.",
    "privacy": "Drafts remain in memory and clear on completion/run termination. No answer values or host capabilities in desktop Message/host reply Debug. Default values are hints; acceptance requires user-supplied values.",
    "boundary": "DTOs moved from agent to api-types to avoid forbidden desktop→agent dependency; existing agent import paths retained. Unsupported schemas remain rejected by task24 broker."
  },
  "pending_regression": {
    "command": "cargo test -p vw-desktop --lib --all-features app::message::view::tests -- --nocapture",
    "exit_code": 101,
    "effective_tests": 13,
    "record": "t25/final2-3.log",
    "failures": [
      "app::message::view::tests::update_routes_panel_layout_theme_and_activity_messages",
      "app::message::view::tests::system_settings_messages_hide_and_restore_running_work_browser"
    ],
    "reason": "Both failures also reproduce in the original --lib target. Existing settings routing tests fail at view/tests.rs:193 (show_settings) and :328 (browser controller show). MCP-only change is Escape handling; those test functions do not call that branch. Tests and settings semantics were not modified."
  },
  "limitations": [
    "Only macOS native drawing verified. No public remote service or Linux/Windows acceptance claimed.",
    "Form-only frozen primitive schema; hosted identity, URL/auth and nested schemas are outside task25.",
    "Task18 cross-chat reuse and task19 schema compression/model exposure gaps remain recorded, without implementing independent new behavior.",
    "Raw logs and *.run.json stay local/ignored. Only structured evidence, synthetic fixtures and selected sanitized native screenshots are committed.",
    "Initial native harness screenshot scheduling race was fixed; window-check partial run is diagnostic only. Full successful native evidence is window2-2."
  ],
