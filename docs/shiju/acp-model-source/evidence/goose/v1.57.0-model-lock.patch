+    /// Keep native transcripts across request-owned config/key revocation.
+    pub fn prepare_managed_history() -> anyhow::Result<()> {
+        std::env::remove_var("SHIJU_GOOSE_HISTORY_ROOT");
+        let Ok(reference) = std::env::var("VW_ACP_LAUNCH_REFERENCE") else {
+            return Ok(());
+        };
+        let digest = reference
+            .strip_prefix("vw-session-model:")
+            .ok_or_else(|| anyhow::anyhow!("invalid managed Goose reference"))?;
+        anyhow::ensure!(
+            digest.len() == 64
+                && digest.bytes().all(|b| b.is_ascii_hexdigit() && !b.is_ascii_uppercase()),
+            "invalid managed Goose reference"
+        );
+        #[cfg(unix)]
+        {
+            use std::os::unix::fs::{DirBuilderExt, MetadataExt, PermissionsExt};
+            let uid = unsafe { libc::geteuid() };
+            let root = std::env::temp_dir().join(format!("shiju-goose-state-{uid}"));
+            let history = root.join(digest);
+            for directory in [&root, &history] {
+                match std::fs::DirBuilder::new().mode(0o700).create(directory) {
+                    Ok(()) => {}
+                    Err(error) if error.kind() == std::io::ErrorKind::AlreadyExists => {}
+                    Err(error) => return Err(error.into()),
+                }
+                let metadata = directory.symlink_metadata()?;
+                anyhow::ensure!(
+                    metadata.is_dir()
+                        && metadata.uid() == uid
+                        && metadata.permissions().mode() & 0o777 == 0o700,
+                    "insecure managed Goose transcript directory"
+                );
+            }
+            std::env::set_var("SHIJU_GOOSE_HISTORY_ROOT", history);
+            Ok(())
+        }
+        #[cfg(not(unix))]
+        anyhow::bail!("managed Goose transcript ACL verification unavailable")
