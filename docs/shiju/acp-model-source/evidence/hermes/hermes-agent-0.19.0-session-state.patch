+def session_skill_root() -> Optional[Path]:
+    """Resolve the reviewed process-owned root without changing model configuration."""
+    raw = os.environ.get("SHIJU_HERMES_SKILL_ROOT")
+    if raw is None or raw == "":
+        return None
+    root = Path(raw)
+    if not root.is_absolute() or not root.is_dir() or root.is_symlink():
+        raise ValueError("Invalid session skill directory")
+    return root
+
