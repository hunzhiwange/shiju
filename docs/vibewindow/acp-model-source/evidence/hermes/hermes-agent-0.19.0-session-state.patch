@@ -0,0 +1,48 @@
+"""Credential-free ACP history owned by the managed session reference."""
+from __future__ import annotations
+
+import os
+from pathlib import Path
+import re
+import stat
+import tempfile
+
+REFERENCE = "VW_ACP_LAUNCH_REFERENCE"
+
+
+def database_path(*, required: bool = False) -> Path | None:
+    reference = os.environ.get(REFERENCE)
+    if reference is None:
+        if required:
+            raise ValueError("Hermes managed session reference is required")
+        return None
+    match = re.fullmatch(r"vw-session-model:([0-9a-f]{64})", reference)
+    if match is None or os.name != "posix":
+        raise ValueError("Hermes managed session state is unavailable")
+    root = Path(tempfile.gettempdir()) / f"shiju-hermes-state-{os.getuid()}"
+    directory = root / match.group(1)
+    for path in (root, directory):
+        try:
+            path.mkdir(mode=0o700)
+        except FileExistsError:
+            pass
+        info = path.lstat()
+        if (not stat.S_ISDIR(info.st_mode) or info.st_uid != os.getuid()
+                or stat.S_IMODE(info.st_mode) != 0o700):
+            raise ValueError("insecure Hermes managed history directory")
+    path = directory / "state.db"
+    try:
+        fd = os.open(path, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o600)
+    except FileExistsError:
+        pass
+    else:
+        os.close(fd)
+    for candidate in (path, directory / "state.db-wal", directory / "state.db-shm"):
+        try:
+            info = candidate.lstat()
+        except FileNotFoundError:
+            continue
+        if (not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid()
+                or stat.S_IMODE(info.st_mode) & 0o077):
+            raise ValueError("insecure Hermes managed history file")
+    return path
