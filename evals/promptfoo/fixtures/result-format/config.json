{
  "prompts": [
    "{{input}}"
  ],
  "providers": [
    {
      "id": "file://provider.cjs",
      "label": "offline-fixed"
    }
  ],
  "tests": [
    {
      "description": "case-pass",
      "vars": {
        "input": "alpha"
      },
      "assert": [
        {
          "type": "equals",
          "value": "fixed",
          "metric": "correctness"
        }
      ]
    },
    {
      "description": "case-fail",
      "vars": {
        "input": "beta"
      },
      "assert": [
        {
          "type": "equals",
          "value": "different",
          "metric": "correctness"
        }
      ]
    }
  ]
}
