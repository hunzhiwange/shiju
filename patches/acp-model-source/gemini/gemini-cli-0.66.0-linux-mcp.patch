@@ -0,0 +1,59 @@
+// Shared by the ACP caller and every bundled MCP execution entry.
+const mountedByConfig = new WeakMap();
+const approvedInvocations = new WeakMap();
+
+export function isManagedLinuxMcp() {
+  return process.platform === "linux" && process.argv.includes("--shiju-model-source");
+}
+
+export function validateMountedServers(servers, configured, required, serverCommand) {
+  const names = new Set();
+  for (const {name} of servers) {
+    if (names.has(name) || Object.hasOwn(configured, name) ||
+        Object.hasOwn(required ?? {}, name) || Object.hasOwn(Object.prototype, name) ||
+        (name === "mcp" && serverCommand)) {
+      throw new Error("Gemini MCP mount conflicts with another server name.");
+    }
+    names.add(name);
+  }
+}
+
+export function setMountedServers(config, servers) {
+  if (isManagedLinuxMcp()) {
+    mountedByConfig.set(config, new Set(servers.map(({name}) => name)));
+  }
+}
+
+export function describeMcpTool(config, invocation, tool) {
+  const mounted = mountedByConfig.get(config);
+  if (!mounted || !tool.serverName || !tool.serverToolName ||
+      !invocation.params || Array.isArray(invocation.params) || typeof invocation.params !== "object") {
+    throw new Error("Gemini MCP invocation lacks an approval identity.");
+  }
+  const isMounted = mounted.has(tool.serverName);
+  if (isMounted && (tool.extensionName || tool.extensionId)) {
+    throw new Error("Gemini MCP extension conflicts with a mounted server.");
+  }
+  const snapshot = JSON.stringify(invocation.params);
+  return {
+    source: {origin: isMounted ? "mounted" : "native", server: tool.serverName, tool: tool.serverToolName},
+    input: JSON.parse(snapshot),
+    snapshot
+  };
+}
+
+export function authorizeMcpInvocation(invocation, approval, signal) {
+  approvedInvocations.set(invocation, {approval, signal});
+}
+
+export function consumeMcpApproval(invocation, signal) {
+  if (!isManagedLinuxMcp()) return;
+  const grant = approvedInvocations.get(invocation);
+  approvedInvocations.delete(invocation);
+  if (!grant || grant.signal !== signal || signal.aborted ||
+      grant.approval.source.server !== invocation.serverName ||
+      grant.approval.source.tool !== invocation.serverToolName ||
+      grant.approval.snapshot !== JSON.stringify(invocation.params)) {
+    throw new Error("Gemini MCP execution requires a current, matching one-time host approval.");
+  }
+}
