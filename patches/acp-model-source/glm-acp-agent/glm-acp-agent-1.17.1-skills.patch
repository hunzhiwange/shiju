+/**
+ * The managed host registers the verified session links and their exact targets.
+ * Only files the workspace-confined native reader can open enter the model menu.
+ */
+export function modelSkillCatalog(cwd, commands) {
+    const view = process.env.SHIJU_GLM_SKILL_VIEW;
+    if (view === undefined)
+        return [];
+    const workspace = realpathSync(cwd);
+    const within = (root, file) => {
+        const path = relative(root, file);
+        return path !== "" && !isAbsolute(path) && path !== ".." && !path.startsWith(".." + sep);
+    };
+    const native = new Map(commands.map(command => [command.name, command]));
+    const skills = [];
+    for (const command of native.values()) {
+        if (!command.skill)
+            continue;
+        try {
+            const source = realpathSync(command.source);
+            if (within(workspace, source))
+                skills.push({ name: command.name, path: source });
+        }
+        catch { /* A removed project skill is no longer discoverable. */ }
+    }
+    for (const [name, link, target] of JSON.parse(view)) {
+        if (native.has(name))
+            continue;
+        if (realpathSync(link) !== target || !within(workspace, target))
+            throw new Error("Invalid GLM session skill link");
+        const source = realpathSync(pathJoin(link, "SKILL.md"));
+        if (source !== pathJoin(target, "SKILL.md"))
+            throw new Error("Invalid GLM session skill file");
+        skills.push({ name, path: source });
+    }
+    return skills;
