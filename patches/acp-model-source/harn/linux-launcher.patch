+    async def approve_write(self, identifier, turn, call_id, translated):
+        if self.cancelled or self.turn != turn:
+            await self.send(fail(identifier, 'Harn write approval expired'))
+            return
+        approval = APPROVAL_PREFIX + uuid.uuid4().hex
+        waiter = asyncio.get_running_loop().create_future()
+        self.pending[approval] = waiter
+        try:
+            self.host({'id': approval, 'method': 'session/request_permission', 'params': {
+                'sessionId': turn[1],
+                'toolCall': {'toolCallId': call_id, 'title': 'Harn write_file', 'kind': 'edit',
+                             'rawInput': {'path': translated['path'], 'content': translated['content']}},
+                'options': [
+                    {'optionId': 'allow_once', 'kind': 'allow_once', 'name': 'Allow once'},
+                    {'optionId': 'reject_once', 'kind': 'reject_once', 'name': 'Reject'},
+                ],
+            }})
+            response = await asyncio.wait_for(waiter, 300)
+            approved = response == {'outcome': {'outcome': 'selected', 'optionId': 'allow_once'}}
+        except (TimeoutError, asyncio.CancelledError):
+            approved = False
+        finally:
+            self.pending.pop(approval, None)
+        if approved and not self.cancelled and self.turn == turn:
+            self.host({'id': identifier, 'params': translated, 'method': 'fs/write_text_file'})
+        else:
+            await self.send(fail(identifier, 'Harn write was not approved'))
