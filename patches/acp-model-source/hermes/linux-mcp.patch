+        for server in servers:
+            if (
+                not isinstance(server, McpServerHttp)
+                or not re.fullmatch(r"[a-zA-Z0-9_-]+", server.name)
+                or server.name in names
+                or base.scheme != "http"
+                or base.hostname != "127.0.0.1"
+                or base.port is None
+                or base.netloc != f"127.0.0.1:{base.port}"
+                or server.url != f"{origin}/shiju-vtcode-mcp/{server.name}"
+                or len(server.headers) != 1
+                or server.headers[0].name.lower() != "authorization"
+                or not server.headers[0].value.startswith("Bearer ")
+                or not server.headers[0].value[7:].strip()
+            ):
+                raise RuntimeError("Hermes managed MCP requires the host MCP relay")
+            names.add(server.name)
+        self._managed_mcp_scope = scope
+        return True
