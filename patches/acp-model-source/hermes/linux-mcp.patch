+    def _bind_managed_mcp_scope(self, session_id, servers):
+        # Hermes keeps MCP connections process-wide. A changed ACP scope must
+        # revoke this process instead of refreshing its stale tool registry.
+        scope = (session_id, [server.model_dump() for server in servers])
+        if self._managed_mcp_scope is not None:
+            if self._managed_mcp_ready and self._managed_mcp_scope == scope:
+                return False
+            self._managed_mcp_ready = False
+            self._managed_mcp_scope = ()
+            raise RuntimeError("Hermes managed MCP scope changed; restart the runtime")
@@ -791,0 +808,23 @@
+        base = urlparse(os.environ["CUSTOM_BASE_URL"])
