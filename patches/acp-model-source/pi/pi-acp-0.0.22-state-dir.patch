diff --git a/src/acp/session-mcp.ts b/src/acp/session-mcp.ts
new file mode 100644
index 0000000..0bd19db
--- /dev/null
+++ b/src/acp/session-mcp.ts
@@ -0,0 +1,95 @@
+import { createHash } from 'node:crypto'
+import { execFile } from 'node:child_process'
+import { realpath } from 'node:fs/promises'
+import { isAbsolute } from 'node:path'
+import { fileURLToPath } from 'node:url'
+import type { McpServer } from '@agentclientprotocol/sdk'
+
+export const extension = fileURLToPath(new URL('./shiju-mcp-extension.mjs', import.meta.url))
+const helper = fileURLToPath(new URL('./shiju-mcp.py', import.meta.url))
+const namePattern = /^[a-zA-Z0-9]+(?:_[a-zA-Z0-9]+)*$/
+
+type Stdio = { name: string; command: string; args: string[] }
+type Descriptor = { name: string; description: string; inputSchema: { type: string } }
+type Policy = { allow?: string[]; deny?: string[] }
+
+export type SessionMcp = {
+  catalog: Descriptor[]
+  call(name: string, args: Record<string, unknown>, signal: AbortSignal): Promise<string>
+}
+
+function operation(
+  request: { operation: 'list' | 'call'; workspace: string; server: Stdio; name?: string; arguments?: unknown },
+  signal?: AbortSignal
+): Promise<string> {
+  signal?.throwIfAborted()
+  return new Promise((resolve, reject) => {
+    const child = execFile('/usr/bin/python3', ['-I', helper], {
+      env: { HOME: process.env.HOME, PATH: '/usr/bin:/bin' },
+      maxBuffer: 4 * 1024 * 1024,
+      timeout: 20000
+    }, (error, stdout) => {
+      signal?.removeEventListener('abort', disconnect)
+      if (error || signal?.aborted) reject(new Error('Selected MCP operation failed or was cancelled'))
+      else resolve(stdout)
+    })
+    function disconnect() {
+      child.stdin?.end()
+    }
+    child.stdin?.on('error', () => child.kill())
+    signal?.addEventListener('abort', disconnect, { once: true })
+    child.stdin?.write(JSON.stringify(request) + '\n')
+  })
+}
+
+export async function discoverMcp(servers: McpServer[], cwd: string): Promise<SessionMcp | undefined> {
+  if (!servers.length) return undefined
+  if (process.platform !== 'darwin' || process.env.SHIJU_PI_SKILL_ROOT === undefined || servers.length > 16) {
+    throw new Error('Pi MCP requires the reviewed managed macOS stdio sandbox')
+  }
+  const workspace = await realpath(cwd)
+  const tools = new Map<string, { server: Stdio; tool: string }>()
+  const catalog: Descriptor[] = []
+  const names = new Set<string>()
+
+  for (const definition of servers) {
+    if (!('command' in definition) || !namePattern.test(definition.name) || names.has(definition.name) ||
+        !isAbsolute(definition.command) || definition.env.length) {
+      throw new Error('Pi MCP requires uniquely named absolute stdio servers without environment overrides')
+    }
+    names.add(definition.name)
+    const { name, command, args } = definition
+    const server = { name, command, args }
+    const policy = definition._meta?.['shiju.pi.toolPolicy'] as Policy | undefined
+    const discovered = JSON.parse(await operation({ operation: 'list', workspace, server })) as Descriptor[]
+    if (!discovered.length) throw new Error('Selected Pi MCP server did not expose tools')
+    for (const descriptor of discovered) {
+      const id = name + '__' + descriptor.name
+      let policyId = 'mcp__' + id.toLowerCase()
+      if (id !== id.toLowerCase() || policyId.length > 64) {
+        const hash = createHash('sha256').update(name + '\0' + descriptor.name).digest('hex').slice(0, 16)
+        policyId = policyId.slice(0, 47) + '_' + hash
+      }
+      const matches = (list: string[] | undefined) => list?.some(item => item === descriptor.name || item === policyId)
+      if (matches(policy?.deny) || (policy?.allow?.length && !matches(policy.allow))) continue
+      if (!namePattern.test(descriptor.name) || id.length > 64 || tools.has(id) ||
+          descriptor.inputSchema?.type !== 'object' || tools.size >= 256) {
+        throw new Error('Invalid or duplicate selected Pi MCP tool descriptor')
+      }
+      tools.set(id, { server, tool: descriptor.name })
+      catalog.push({ name: id, description: `MCP server ${name}. ${descriptor.description ?? descriptor.name}`,
+        inputSchema: descriptor.inputSchema })
+    }
+  }
+
+  if (Buffer.byteLength(JSON.stringify(catalog)) > 100000) throw new Error('Pi MCP catalog exceeds launch limit')
+  return {
+    catalog,
+    call(name, args, signal) {
+      const entry = tools.get(name)
+      if (!entry) throw new Error('Tool is outside the selected Pi MCP catalog')
+      return operation({ operation: 'call', workspace, server: entry.server,
+        name: entry.tool, arguments: args }, signal)
+    }
+  }
+}
