+import { realpath } from 'node:fs/promises'
+import { dirname, isAbsolute, join, relative, sep } from 'node:path'
+import { pathToFileURL } from 'node:url'
+import { getAgentDir } from '../acp/pi-settings.js'
+import { extension, type SessionMcp } from '../acp/session-mcp.js'
@@ -3,0 +9,31 @@ import * as readline from 'node:readline'
+// Use the pinned Pi resolver for project skill overrides and .gitignore rules.
+async function projectSkillFiles(cwd: string, engine: string): Promise<string[]> {
+  const workspace = await realpath(cwd)
+  const root = join(workspace, '.pi', 'skills')
+  const resolvedRoot = await realpath(root).catch((error: NodeJS.ErrnoException) => {
+    if (error.code === 'ENOENT') return undefined
+    throw error
+  })
+  // A native root or skill symlink cannot introduce files from another tree.
+  if (resolvedRoot !== root) return []
+  const agentDir = getAgentDir()
+  const { DefaultPackageManager, SettingsManager } = await import(pathToFileURL(join(dirname(engine), 'index.js')).href)
+  const settings = SettingsManager.create(workspace, agentDir)
+  const skillPatterns = settings.getProjectSettings().skills
+  const resolver = new DefaultPackageManager({
+    cwd: workspace, agentDir,
+    settingsManager: { getGlobalSettings: () => ({}), getProjectSettings: () => ({ skills: skillPatterns }) }
+  })
+  const files: string[] = []
+  const within = (path: string) => {
+    const suffix = relative(root, path)
+    return suffix !== '' && suffix !== '..' && !suffix.startsWith('..' + sep) && !isAbsolute(suffix)
+  }
+  for (const skill of (await resolver.resolve()).skills) {
+    if (!skill.enabled || !within(skill.path)) continue
+    const target = await realpath(skill.path)
+    if (within(target)) files.push(skill.path)
+  }
+  return files
+}
