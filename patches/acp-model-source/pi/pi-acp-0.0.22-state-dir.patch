+            { optionId: 'reject', name: 'Reject this call', kind: 'reject_once' }
+          ]
+        }).then(resolve, reject).finally(() => signal.removeEventListener('abort', abort))
+      })
+      if (response.outcome.outcome === 'selected' && response.outcome.optionId === 'allow') {
+        value = await this.proc.mcp.call(name, args, signal)
+      }
+    } catch {
+      // A disconnected, failed or cancelled operation never supplies a result.
+    } finally {
+      this.proc.respondMcp(id, value)
+    }
+  }
