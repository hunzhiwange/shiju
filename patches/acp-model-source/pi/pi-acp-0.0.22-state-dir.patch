+import { isAbsolute, join } from 'node:path'
@@ -9,0 +10,5 @@ export function getPiAcpDir(): string {
+  const directory = process.env.PI_ACP_STATE_DIR
+  if (directory !== undefined) {
+    if (!isAbsolute(directory)) throw new Error('PI_ACP_STATE_DIR must be absolute')
+    return directory
+  }
