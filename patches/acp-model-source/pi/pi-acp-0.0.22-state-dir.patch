diff --git a/src/acp/agent.ts b/src/acp/agent.ts
index 8f4e8b8..6ca7fd1 100644
--- a/src/acp/agent.ts
+++ b/src/acp/agent.ts
@@ -1270,12 +1270,19 @@ function buildStartupInfo(opts: {
-  // Global skills
-  // Use getAgentDir() so this respects PI_CODING_AGENT_DIR overrides.
-  const globalSkillsDir = join(getAgentDir(), 'skills')
-  pushSkillFromRoot(globalSkillsDir)
-
-  // Also support ~/.agents/skills (pi skill discovery)
-  const legacyAgentsSkillsDir = join(process.env.HOME ?? '', '.agents', 'skills')
-  pushSkillFromRoot(legacyAgentsSkillsDir)
-
-  // Project skills (.pi/skills)
-  const projectSkillsDir = join(opts.cwd, '.pi', 'skills')
-  pushSkillFromRoot(projectSkillsDir)
+  const skillRoot = process.env.SHIJU_PI_SKILL_ROOT
+  if (skillRoot !== undefined) {
+    if (skillRoot && !isAbsolute(skillRoot)) throw new Error('SHIJU_PI_SKILL_ROOT must be absolute')
+    if (skillRoot) pushSkillFromRoot(skillRoot)
+  } else {
+    // Global skills
+    // Use getAgentDir() so this respects PI_CODING_AGENT_DIR overrides.
+    const globalSkillsDir = join(getAgentDir(), 'skills')
+    pushSkillFromRoot(globalSkillsDir)
+
+    // Also support ~/.agents/skills (pi skill discovery)
+    const legacyAgentsSkillsDir = join(process.env.HOME ?? '', '.agents', 'skills')
+    pushSkillFromRoot(legacyAgentsSkillsDir)
+
+    // Project skills (.pi/skills)
+    const projectSkillsDir = join(opts.cwd, '.pi', 'skills')
+    pushSkillFromRoot(projectSkillsDir)
+
+  }
diff --git a/src/acp/paths.ts b/src/acp/paths.ts
