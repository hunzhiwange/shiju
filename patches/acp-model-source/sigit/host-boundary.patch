+impl SessionServers {
+    async fn disconnect(&self) {
+        for server in self.0.iter() {
+            *server.conn.write().await = None;
+        }
+    }
+}
+
+pub async fn disconnect_session_servers() {
+    session_servers().disconnect().await;
+}
+
+pub async fn restore_disconnected_session_servers() -> Result<(), &'static str> {
+    for server in session_servers().0.iter() {
+        let disconnected = server.conn.read().await.is_none();
+        if disconnected && reconnect(server).await.is_err() {
+            return Err("Could not restore the selected siGit MCP service");
+        }
+    }
+    Ok(())
 }

+pub async fn call_reviewed_tool(name: &str, arguments: &str) -> Result<String, String> {
+    let session = session_servers();
+    let (server, remote_name) = session
+        .0
+        .iter()
+        .find_map(|server| {
+            server
+                .tools()
+                .iter()
+                .find(|tool| tool.full_name == name)
+                .map(|tool| (server, tool.remote_name.clone()))
+        })
+        .ok_or_else(|| "Unknown session MCP tool".to_string())?;
+    let args = if arguments.trim().is_empty() {
+        json!({})
+    } else {
+        serde_json::from_str::<Value>(arguments)
+            .ok()
+            .filter(Value::is_object)
+            .ok_or_else(|| "MCP tool arguments must be a JSON object".to_string())?
+    };
+    let (output, failed) = call_server(server, &remote_name, args).await?;
+    let output = truncate(output);
+    if failed { Err(output) } else { Ok(output) }
+}
