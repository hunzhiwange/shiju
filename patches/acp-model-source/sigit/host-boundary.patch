+pub async fn managed_stdio_servers(
+    servers: &[agent_client_protocol::schema::v1::McpServer],
+    cwd: &std::path::Path,
+) -> Result<SessionServers, &'static str> {
+    if servers.is_empty() {
+        return Ok(SessionServers::default());
+    }
+    if !cfg!(target_os = "macos") {
+        return Err("siGit MCP requires the reviewed macOS sandbox");
+    }
+    let workspace = cwd
+        .canonicalize()
+        .map_err(|_| "Invalid siGit MCP workspace")?;
+    let home = std::env::var_os("HOME")
+        .map(PathBuf::from)
+        .and_then(|path| path.canonicalize().ok())
+        .ok_or("Invalid siGit host home")?;
+    if !workspace.is_dir() || home.starts_with(&workspace) {
+        return Err("Invalid siGit MCP workspace");
+    }
+    let native_config = std::env::var_os("SIGIT_CONFIG_DIR")
+        .map(PathBuf::from)
+        .unwrap_or_else(|| home.join(".config/sigit"));
