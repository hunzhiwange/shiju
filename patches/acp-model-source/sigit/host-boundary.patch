+const MANAGED_STDIO_SANDBOX: &str = r#"
+(version 1)
+(allow default)
+(deny file-read-data (subpath "/Users") (subpath "/private") (subpath "/Volumes") (subpath "/Library")
+    (subpath "/opt") (subpath "/usr/local") (subpath "/System/Volumes/Data")
