+fn open_managed_skill_file(path: &Path) -> Option<std::fs::File> {
+    use std::ffi::{CString, OsStr};
+    use std::fs::File;
+    use std::os::fd::{AsRawFd, FromRawFd};
+    use std::os::unix::ffi::OsStrExt;
+    use std::path::Component;
+
+    fn open_child(parent: &File, name: &OsStr, flags: libc::c_int) -> Option<File> {
+        let name = CString::new(name.as_bytes()).ok()?;
+        // The caller supplies one path component and never requests creation.
+        let fd = unsafe {
+            libc::openat(
+                parent.as_raw_fd(),
+                name.as_ptr(),
+                flags | libc::O_NOFOLLOW | libc::O_CLOEXEC,
+            )
+        };
+        if fd < 0 {
+            return None;
+        }
+        // A successful openat returns a new descriptor owned by this call.
+        Some(unsafe { File::from_raw_fd(fd) })
+    }
+
+    // Open every ancestor without following links. Holding each directory
+    // descriptor prevents replacement of its path from redirecting the read.
+    let mut parent = File::open("/").ok()?;
+    for component in path.parent()?.strip_prefix("/").ok()?.components() {
+        let Component::Normal(name) = component else {
+            return None;
+        };
+        parent = open_child(&parent, name, libc::O_PATH | libc::O_DIRECTORY)?;
+    }
+    open_child(&parent, path.file_name()?, libc::O_RDONLY | libc::O_NONBLOCK)
+}
