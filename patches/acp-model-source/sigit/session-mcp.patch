+const MANAGED_STDIO_SANDBOX: &str = r#"
+(version 1)
+(allow default)
+(deny file-read-data (subpath "/Users") (subpath "/private") (subpath "/Volumes") (subpath "/Library")
+    (subpath "/opt") (subpath "/usr/local") (subpath "/System/Volumes/Data")
+    (subpath (param "host-home")))
+(allow file-read-data (literal (param "command")) (subpath (param "workspace")))
+(deny file-read-data (subpath (param "git")) (subpath (param "codex"))
+    (subpath (param "native-config")) (literal (param "mount-config"))
+    (regex #"(^|/)\.env($|\.)"))
+(deny file-write*)
+(allow file-write* (literal "/dev/null"))
+(deny process-fork process-exec network* mach-lookup)
+(allow process-exec (literal (param "command")))
+"#;
+
+pub async fn managed_stdio_servers(
+    servers: &[agent_client_protocol::schema::v1::McpServer],
+    cwd: &std::path::Path,
+) -> Result<SessionServers, &'static str> {
+    if servers.is_empty() {
+        return Ok(SessionServers::default());
+    }
+    if !cfg!(target_os = "macos") {
+        return Err("siGit MCP requires the reviewed macOS sandbox");
+    }
+    let workspace = cwd
+        .canonicalize()
+        .map_err(|_| "Invalid siGit MCP workspace")?;
+    let home = std::env::var_os("HOME")
+        .map(PathBuf::from)
+        .and_then(|path| path.canonicalize().ok())
+        .ok_or("Invalid siGit host home")?;
+    if !workspace.is_dir() || home.starts_with(&workspace) {
+        return Err("Invalid siGit MCP workspace");
+    }
+    let native_config = std::env::var_os("SIGIT_CONFIG_DIR")
+        .map(PathBuf::from)
+        .unwrap_or_else(|| home.join(".config/sigit"));
+    let mut selected = Vec::with_capacity(servers.len());
+    for server in servers {
+        let agent_client_protocol::schema::v1::McpServer::Stdio(server) = server else {
+            return Err("siGit MCP accepts only isolated stdio services");
+        };
+        if !server.command.is_absolute()
+            || !server.env.is_empty()
+            || server.name.is_empty()
+            || !server
+                .name
+                .bytes()
+                .all(|b| b.is_ascii_alphanumeric() || b == b'_' || b == b'-')
+        {
+            return Err("Invalid siGit MCP service definition");
+        }
+        let command = server
+            .command
+            .canonicalize()
+            .map_err(|_| "Invalid siGit MCP command")?;
+        if !command.is_file() {
+            return Err("Invalid siGit MCP command");
+        }
+        let mut args = [
+            "-i",
+            "-C",
+            workspace.to_str().ok_or("Invalid siGit MCP workspace")?,
+            "HOME=/var/empty",
+            "TMPDIR=/var/empty",
+            "LANG=en_US.UTF-8",
+            "/usr/bin/sandbox-exec",
+            "-p",
+            MANAGED_STDIO_SANDBOX,
+        ]
+        .map(str::to_owned)
+        .to_vec();
+        for (name, path) in [
+            ("command", command.clone()),
+            ("workspace", workspace.clone()),
+            ("host-home", home.clone()),
+            ("native-config", native_config.clone()),
+            ("git", workspace.join(".git")),
+            ("codex", workspace.join(".codex")),
+            ("mount-config", workspace.join(".vwacprc.json")),
+        ] {
+            let path = path.to_str().ok_or("Invalid siGit MCP path")?;
+            args.extend(["-D".to_string(), format!("{name}={path}")]);
+        }
+        args.push(
+            command
+                .to_str()
+                .ok_or("Invalid siGit MCP command")?
+                .to_string(),
+        );
+        args.extend(server.args.iter().cloned());
+        selected.push(ClientServer {
+            name: server.name.clone(),
+            transport: ClientTransport::Stdio {
+                command: "/usr/bin/env".into(),
+                args,
+                env: vec![("OPENAI_API_KEY".into(), String::new())],
+            },
+        });
+    }
+    let connected = connect_session_servers(selected).await;
+    if connected.0.iter().any(|server| server.tools().is_empty()) {
+        connected.disconnect().await;
+        return Err("siGit MCP service failed to expose tools in the read-only sandbox");
+    }
+    Ok(connected)
+}
+
+impl SessionServers {
+    async fn disconnect(&self) {
+        for server in self.0.iter() {
+            *server.conn.write().await = None;
+        }
+    }
+}
+
+pub async fn disconnect_session_servers() {
+    session_servers().disconnect().await;
+}
+
+pub async fn restore_disconnected_session_servers() -> Result<(), &'static str> {
+    for server in session_servers().0.iter() {
+        let disconnected = server.conn.read().await.is_none();
+        if disconnected && reconnect(server).await.is_err() {
+            return Err("Could not restore the selected siGit MCP service");
+        }
+    }
+    Ok(())
+}
+
+pub async fn call_reviewed_tool(name: &str, arguments: &str) -> Result<String, String> {
+    let session = session_servers();
+    let (server, remote_name) = session
+        .0
+        .iter()
+        .find_map(|server| {
+            server
+                .tools()
+                .iter()
+                .find(|tool| tool.full_name == name)
+                .map(|tool| (server, tool.remote_name.clone()))
+        })
+        .ok_or_else(|| "Unknown session MCP tool".to_string())?;
+    let args = if arguments.trim().is_empty() {
+        json!({})
+    } else {
+        serde_json::from_str::<Value>(arguments)
+            .ok()
+            .filter(Value::is_object)
+            .ok_or_else(|| "MCP tool arguments must be a JSON object".to_string())?
+    };
+    let (output, failed) = call_server(server, &remote_name, args).await?;
+    let output = truncate(output);
+    if failed { Err(output) } else { Ok(output) }
+}
