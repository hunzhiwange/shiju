+    def decide(self, identifier, result):
+        with self.lock:
+            entry = self.pending.pop(identifier, None)
+            if entry and self.turn == entry[1][0] and isinstance(result, dict) and result.get('outcome') == {
+                'outcome': 'selected', 'optionId': entry[0]
+            }:
+                self.approved.append((entry[1], monotonic() + TIMEOUT))
+
+    def claim(self, server, tool, arguments, metadata):
+        # The HTTP dispatcher holds the same lock as turn cancellation.
+        if not isinstance(metadata, dict) or self.turn is None:
+            return None
+        session = metadata.get('dev.shiju/acp-session-id')
+        call_id = metadata.get('dev.shiju/acp-tool-call-id')
+        if session != self.turn or not isinstance(call_id, str) or not call_id:
+            return None
+        identity = (session, call_id, server, tool, arguments_key(arguments))
+        now = monotonic()
+        self.approved[:] = [entry for entry in self.approved if entry[1] > now]
+        for index, (approval, _) in enumerate(self.approved):
+            if identity == approval:
+                self.approved.pop(index)
+                return identity
+        return None
+
+    def request(self, server, method, params):
+        if method != 'tools/call':
+            return super().request(server, method, params)
+        arguments = params.get('arguments')
+        tool = params.get('name')
+        if not isinstance(arguments, dict) or not isinstance(tool, str):
+            raise ValueError('Invalid Stakpak MCP call')
+        with self.lock:
+            if self.worker is not None or self.claim(server, tool, arguments, params.get('_meta')) is None:
+                raise ValueError('No matching Stakpak MCP approval')
+            worker = asyncio.run_coroutine_threadsafe(
+                self.execute(server, tool, arguments), self.loop)
+            self.worker = worker
+        try:
+            return worker.result(TIMEOUT + 2)
+        finally:
+            with self.lock:
+                worker.cancel()
+                self.worker = None


