+/// Managed ACP discovers only contained, model-invocable local skills.
+pub fn discover_managed_acp_skills() -> Vec<Skill> {
+    let Ok(cwd) = std::env::current_dir() else {
+        return Vec::new();
+    };
+    let roots = default_skill_directories()
+        .into_iter()
+        .map(|path| cwd.join(path))
+        .filter(|path| path.canonicalize().is_ok_and(|real| real == *path))
+        .collect::<Vec<_>>();
+    discover(&roots, true)
+}
