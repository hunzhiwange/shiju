+
+fn check_skill_workspace(cwd: &Path) -> Result<(), acp::Error> {
+    if managed_skills() && !cwd.canonicalize().is_ok_and(|path| {
+        std::env::current_dir().is_ok_and(|current| current == path)
+    }) {
+        return Err(acp::Error::invalid_params().data("Managed Stakpak skill workspace mismatch"));
+    }
+    Ok(())
+}

