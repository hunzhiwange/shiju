+pub(crate) fn managed_linux_launch() -> bool {
+    cfg!(target_os = "linux") && std::env::var_os("VW_ACP_LAUNCH_REFERENCE").is_some()
+}
+
+fn allows_permission_option(option: &str, managed: bool) -> bool {
+    option == TOOL_PERMISSION_ALLOW_OPTION_ID
+        || (!managed && option == TOOL_PERMISSION_ALLOW_ALWAYS_OPTION_ID)
+}
