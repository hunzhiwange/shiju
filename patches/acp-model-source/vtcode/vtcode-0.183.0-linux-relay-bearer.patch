 pub(crate) fn shiju_relay_client(
     config: &TimeoutsConfig,
     socket: &std::path::Path,
+    authorization: reqwest::header::HeaderValue,
 ) -> Result<Client, reqwest::Error> {
+    let mut headers = reqwest::header::HeaderMap::new();
+    drop(headers.insert(reqwest::header::AUTHORIZATION, authorization));
     Client::builder()
         .unix_socket(socket.to_path_buf())
+        .default_headers(headers)
         .no_proxy()
         .redirect(reqwest::redirect::Policy::none())
         .connect_timeout(HttpClientFactory::connect_timeout(config))
         .timeout(HttpClientFactory::llm_timeout(config))
         .build()
+}
+
+#[cfg(target_os = "linux")]
+pub(crate) fn shiju_relay_authorization(
+    config: &std::path::Path,
+) -> Option<reqwest::header::HeaderValue> {
+    use std::io::{BufRead, BufReader, Read};
+    let file = std::fs::File::open(config).ok()?;
+    let mut prefix = String::new();
+    BufReader::new(file.take(128)).read_line(&mut prefix).ok()?;
+    let (token, _) = vtcode_commons::http::split_shiju_relay_config(&prefix)?;
+    let mut authorization = reqwest::header::HeaderValue::from_str(&format!("Bearer {token}")).ok()?;
+    authorization.set_sensitive(true);
+    Some(authorization)
 }

