+#[test]
+fn shiju_relay_rejects_unmarked_and_malformed_credentials() {
+    let directory = tempfile::tempdir().unwrap();
+    let config = directory.path().join("vtcode.toml");
+    assert!(shiju_relay_authorization(&config).is_none());
+    for invalid in [
+        r#"api_key = "example""#.to_owned(),
+        format!("# shiju-relay-bearer = {}\n", "a".repeat(65)),
+        format!("# shiju-relay-bearer = {}", "a".repeat(64)),
+        format!("# shiju-relay-bearer = {}\n", "Z".repeat(64)),
+    ] {
+        std::fs::write(&config, invalid).unwrap();
+        assert!(shiju_relay_authorization(&config).is_none());
+    }
+}
