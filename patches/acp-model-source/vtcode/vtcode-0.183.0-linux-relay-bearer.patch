+/// Split the first-line launch credential from the normal TOML. Never attach the
+/// input to an error: callers may report malformed launch configuration.
+#[cfg(target_os = "linux")]
+pub fn split_shiju_relay_config(content: &str) -> Option<(&str, &str)> {
+    let (header, toml) = content.split_once('\n')?;
+    let token = header.strip_prefix("# shiju-relay-bearer = ")?;
+    (token.len() == 64 && token.bytes().all(|byte| matches!(byte, b'0'..=b'9' | b'a'..=b'f')))
+        .then_some((token, toml))
+}

