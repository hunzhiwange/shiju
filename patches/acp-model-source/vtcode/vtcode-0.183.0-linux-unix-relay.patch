+#[cfg(target_os = "linux")]
+pub(crate) fn shiju_relay_client(
+    config: &TimeoutsConfig,
+    socket: &std::path::Path,
+) -> Result<Client, reqwest::Error> {
+    Client::builder()
+        .unix_socket(socket.to_path_buf())
+        .no_proxy()
+        .redirect(reqwest::redirect::Policy::none())
+        .connect_timeout(HttpClientFactory::connect_timeout(config))
+        .timeout(HttpClientFactory::llm_timeout(config))
+        .build()
+}
