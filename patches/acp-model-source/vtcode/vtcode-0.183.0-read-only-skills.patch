+pub fn discover_acp_skills(workspace: &Path, home: &Path, selected: Option<&Path>) -> Vec<crate::skills::SkillMetadata> {
+    let mut outcome = SkillLoadOutcome::default();
+    for (path, scope) in [
+        (workspace.join(".agents/skills"), SkillScope::Repo),
+        (home.join(".agents/skills"), SkillScope::User),
+    ].into_iter().chain(selected.map(|path| (path.to_path_buf(), SkillScope::User))) {
+        discovery::discover_scoped_skill_metadata(
+            &SkillRoot { path, scope, is_tool_root: false, is_plugin_root: false },
+            &mut outcome,
+        );
+    }
+    outcome.skills.retain(|skill| skill.manifest.as_ref().is_some_and(|manifest| {
+        manifest.variety == crate::skills::types::SkillVariety::AgentSkill
+    }));
+    dedup_and_sort(&mut outcome);
+    filter_disabled_skills(&mut outcome, Some(home));
