+use crate::{acp, reports::ToolExecutionReport};
+use anyhow::{Result, ensure};
+use serde_json::{Value, json};
+use std::{
+    collections::BTreeSet,
+    fs,
+    io::Read,
+    path::{Path, PathBuf},
+    sync::Mutex,
+};
+use vtcode_core::{
+    llm::provider::ToolDefinition,
+    permissions::{ResolvedPermissionDecision, build_permission_request, evaluate_effective_permissions},
+    skills::{SkillMetadata, loader::discover_acp_skills, manifest::parse_skill_content},
+    tools::skills::resolve_skill_resource_path,
+};
+
+const LOAD: &str = "load_skill";
+const READ: &str = "load_skill_resource";
+const MAX_BYTES: u64 = 128 * 1024;
+
+impl super::ZedAgent {
+    pub(super) fn allows_session_skill(&self, primary: &str, tool: &str) -> bool {
+        self.primary_agents.allows_local_tool(primary, tool)
+            && self.primary_agents.allows_tool(primary, "read_file", &self.config.workspace)
+    }
+    pub(super) fn allows_skill_path(&self, primary: &str, path: &Path) -> bool {
+        let Some(permissions) = self.primary_agents.permissions_for(primary) else {
+            return false;
+        };
+        let workspace = &self.config.workspace;
+        let args = json!({"path": path});
+        let request = build_permission_request(workspace, workspace, "read_file", Some(&args));
+        evaluate_effective_permissions(&self.permissions_config, permissions, workspace, workspace, &request)
+            != ResolvedPermissionDecision::Deny
+    }
+}
+
+#[derive(Default)]
+pub(crate) struct SessionSkills {
+    entries: Vec<SkillMetadata>,
+    active: Mutex<BTreeSet<String>>,
+}
+
+impl SessionSkills {
+    pub(super) fn discover(workspace: &Path) -> Self {
+        if std::env::var("SHIJU_VTCODE_READ_ONLY_SKILLS").as_deref() != Ok("1") {
+            return Self::default();
+        }
+        let Some(home) = std::env::var_os("HOME").map(PathBuf::from) else {
+            return Self::default();
+        };
+        let selected = std::env::var_os("SHIJU_VTCODE_SELECTED_SKILLS").map(PathBuf::from);
+        Self {
+            entries: discover_acp_skills(workspace, &home, selected.as_deref()),
+            active: Mutex::default(),
+        }
+    }
+
+    pub(super) fn contains_tool(&self, name: &str) -> bool {
+        !self.entries.is_empty() && matches!(name, LOAD | READ)
+    }
+
+    pub(super) fn definitions(&self) -> Vec<ToolDefinition> {
+        if self.entries.is_empty() {
+            return Vec::new();
+        }
+        let catalog: Vec<_> = self
+            .entries
+            .iter()
+            .map(|skill| json!({"name": skill.name, "description": skill.description}))
+            .collect();
+        vec![
+            ToolDefinition::function(
+                LOAD.to_string(),
+                format!(
+                    "Read and activate a skill's instructions for this ACP session. Skill metadata: {}",
+                    json!(catalog)
+                ),
+                json!({"type": "object", "properties": {"name": {"type": "string"}},
+                       "required": ["name"], "additionalProperties": false}),
+            ),
+            ToolDefinition::function(
+                READ.to_string(),
+                "Read a relative resource belonging to a skill activated in this ACP session.".to_string(),
+                json!({"type": "object", "properties": {"skill_name": {"type": "string"},
+                       "resource_path": {"type": "string"}},
+                       "required": ["skill_name", "resource_path"], "additionalProperties": false}),
+            ),
+        ]
+    }
+
+    pub(super) fn execute(&self, tool: &str, args: &Value, permits: impl Fn(&Path) -> bool) -> ToolExecutionReport {
+        match self.read(tool, args, permits) {
+            Ok(output) => {
+                ToolExecutionReport::success(vec![acp::ToolCallContent::from(output.to_string())], Vec::new(), output)
+            }
+            Err(_) => ToolExecutionReport::failure(tool, "Skill read is unavailable for these arguments"),
+        }
+    }
+
+    fn read(&self, tool: &str, args: &Value, permits: impl Fn(&Path) -> bool) -> Result<Value> {
+        let name_key = if tool == LOAD { "name" } else { "skill_name" };
+        let name = args[name_key].as_str().ok_or_else(|| anyhow::anyhow!("Missing skill name"))?;
+        let entry = self
+            .entries
+            .iter()
+            .find(|entry| entry.name == name)
+            .ok_or_else(|| anyhow::anyhow!("Skill is not in the session catalog"))?;
+        let root = entry.path.parent().ok_or_else(|| anyhow::anyhow!("Missing skill directory"))?;
+        ensure!(fs::canonicalize(root)? == root, "Skill directory changed");
+        let mut active = self.active.lock().map_err(|_| anyhow::anyhow!("Skill session unavailable"))?;
+        if tool == LOAD {
+            let path = resolve_skill_resource_path(root, "SKILL.md")?;
+            ensure!(path == entry.path, "Skill manifest changed");
+            ensure!(permits(&path), "Skill manifest read denied");
+            let (manifest, instructions) = parse_skill_content(&read_text(&path)?)?;
+            ensure!(manifest.name == name, "Skill name changed");
+            let _ = active.insert(name.to_owned());
+            Ok(json!({"name": name, "instructions": instructions}))
+        } else {
+            ensure!(active.contains(name), "Skill has not been activated");
+            let relative = args["resource_path"]
+                .as_str()
+                .ok_or_else(|| anyhow::anyhow!("Missing resource"))?;
+            let path = resolve_skill_resource_path(root, relative)?;
+            ensure!(permits(&path), "Skill resource read denied");
+            Ok(json!({"skill_name": name, "resource_path": relative, "content": read_text(&path)?}))
+        }
+    }
+}
+
+fn read_text(path: &Path) -> Result<String> {
+    let file = fs::File::open(path)?;
+    ensure!(file.metadata()?.is_file(), "Skill resource is not a regular file");
+    let mut bytes = Vec::new();
+    let read = file.take(MAX_BYTES + 1).read_to_end(&mut bytes)?;
+    ensure!(read as u64 <= MAX_BYTES, "Skill resource exceeds read limit");
+    Ok(String::from_utf8(bytes)?)
+}
