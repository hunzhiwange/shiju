+use super::ZedAgent;
+use crate::acp;
+use crate::reports::ToolExecutionReport;
+use std::collections::{BTreeMap, HashSet};
+use std::sync::Arc;
+use std::time::Duration;
+use vtcode_config::mcp::{McpClientConfig, McpProviderConfig};
+use vtcode_core::llm::provider::ToolDefinition;
+use vtcode_core::mcp::{McpClient, render_untrusted_mcp_description};
+use vtcode_core::permissions::{ResolvedPermissionDecision, build_permission_request, evaluate_effective_permissions};
+use vtcode_core::tools::mcp::model_visible_mcp_tool_name;
+use vtcode_core::tools::registry::ToolPermissionDecision;
+
+pub(crate) struct SessionMcpTool {
+    pub(super) definition: ToolDefinition,
+    remote_name: String,
+    client: Arc<McpClient>,
+}
+
+impl SessionMcpTool {
+    pub(super) async fn execute(&self, name: &str, arguments: serde_json::Value) -> ToolExecutionReport {
+        match self.client.execute_tool(&self.remote_name, arguments).await {
+            Ok(output) => {
+                ToolExecutionReport::success(vec![acp::ToolCallContent::from(output.to_string())], Vec::new(), output)
+            }
+            Err(error) => ToolExecutionReport::failure(name, &error.to_string()),
+        }
+    }
+}
+
+pub(crate) type SessionMcpTools = BTreeMap<String, SessionMcpTool>;
+
+fn unavailable(reason: &'static str) -> acp::Error {
+    acp::Error::invalid_params().data(serde_json::json!({ "reason": reason }))
+}
+
+pub(super) async fn connect(servers: Vec<acp::McpServer>) -> Result<SessionMcpTools, acp::Error> {
+    let mut providers = Vec::with_capacity(servers.len());
+    let mut names = HashSet::new();
+    for server in servers {
+        let acp::McpServer::Http(server) = server else {
+            return Err(unavailable("ACP MCP requires a host-provided loopback HTTP endpoint"));
+        };
+        let endpoint = url::Url::parse(&server.url).map_err(|_| unavailable("invalid ACP MCP endpoint"))?;
+        if endpoint.scheme() != "http"
+            || endpoint.host_str() != Some("127.0.0.1")
+            || endpoint.port().is_none()
+            || !endpoint.username().is_empty()
+            || endpoint.password().is_some()
+            || endpoint.query().is_some()
+            || endpoint.fragment().is_some()
+            || !names.insert(server.name.clone())
+        {
+            return Err(unavailable("invalid or duplicated ACP MCP endpoint"));
+        }
+        let mut headers = BTreeMap::new();
+        for header in server.headers {
+            let name = header.name.to_ascii_lowercase();
+            if name != "authorization" || headers.insert(name, header.value).is_some() {
+                return Err(unavailable("unsupported or duplicated ACP MCP header"));
+            }
+        }
+        if !headers.get("authorization").is_some_and(|value| {
+            value
+                .strip_prefix("Bearer ")
+                .is_some_and(|token| !token.is_empty() && token.bytes().all(|byte| byte.is_ascii_graphic()))
+        }) {
+            return Err(unavailable("ACP MCP requires a host-issued bearer token"));
+        }
+        let provider: McpProviderConfig = serde_json::from_value(serde_json::json!({
+            "name": server.name,
+            "endpoint": endpoint.as_str(),
+            "http_headers": headers,
+        }))
+        .map_err(|_| unavailable("invalid ACP MCP provider"))?;
+        providers.push(provider);
+    }
+    let mut tools = BTreeMap::new();
+    for provider in providers {
+        // Separate clients keep same-named tools on different providers from
+        // overwriting the native MCP client's unqualified name lookup.
+        let mut client = McpClient::new(McpClientConfig {
+            enabled: true,
+            providers: vec![provider],
+            ..Default::default()
+        });
+        let definitions = tokio::time::timeout(Duration::from_secs(20), async {
+            client.initialize().await?;
+            client.list_tools().await
+        })
+        .await
+        .map_err(|_| unavailable("ACP MCP discovery timed out"))?
+        .map_err(|_| unavailable("ACP MCP discovery failed"))?;
+        if definitions.is_empty() {
+            return Err(unavailable("ACP MCP did not discover any tools"));
+        }
+        let client = Arc::new(client);
+        for tool in definitions {
+            let name = model_visible_mcp_tool_name(&tool.provider, &tool.name);
+            let description = render_untrusted_mcp_description(&tool.provider, &tool.name, &tool.description);
+            let definition = ToolDefinition::function(name.clone(), description, tool.input_schema);
+            let entry = SessionMcpTool {
+                definition,
+                remote_name: tool.name,
+                client: Arc::clone(&client),
+            };
+            if tools.insert(name, entry).is_some() {
+                return Err(unavailable("duplicated ACP MCP tool name"));
+            }
+        }
+    }
+    Ok(tools)
+}
+
+impl ZedAgent {
+    pub(super) fn allows_session_mcp(&self, primary: &str, name: &str) -> bool {
+        !self.primary_agents.is_read_only_agent(primary)
+            && self.primary_agents.allows_local_tool(primary, name)
+            && self.primary_agents.allows_tool(primary, name, self.workspace_root())
+    }
+
+    pub(super) async fn allows_session_mcp_call(
+        &self,
+        primary: &str,
+        name: &str,
+        arguments: &serde_json::Value,
+    ) -> bool {
+        let workspace = self.workspace_root();
+        let request = build_permission_request(workspace, workspace, name, Some(arguments));
+        self.allows_session_mcp(primary, name)
+            && self.primary_agents.permissions_for(primary).is_some_and(|permissions| {
+                evaluate_effective_permissions(&self.permissions_config, permissions, workspace, workspace, &request)
+                    != ResolvedPermissionDecision::Deny
+            })
+            && matches!(
+                self.local_tool_registry.evaluate_tool_policy(name).await,
+                Ok(ToolPermissionDecision::Allow | ToolPermissionDecision::Prompt)
+            )
+    }
+}
