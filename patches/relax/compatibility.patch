+/// The codegen unit's crate, distinct from the executable's entry crate.
+/// A scope is restored on unwind and must remain on the thread that entered it.
+pub struct CodegenCrate {
+    previous: Option<u32>,
+    _thread: std::marker::PhantomData<std::rc::Rc<()>>,
