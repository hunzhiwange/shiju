+impl CodegenCrate {
+    pub fn current() -> u32 { CODEGEN_CRATE.with(|c| c.get()).unwrap_or_else(crate::layout::root_crate) }
+    pub fn enter(krate: u32) -> Self {
+        Self { previous: CODEGEN_CRATE.with(|c| c.replace(Some(krate))), _thread: std::marker::PhantomData }
+    }
+}
+impl Drop for CodegenCrate {
+    fn drop(&mut self) { CODEGEN_CRATE.with(|c| c.set(self.previous)); }
