<?xml version="1.0" encoding="UTF-8"?>
<!-- Serve office/ at https://localhost:3000/office/ with a trusted local certificate.
     The transport must approve exactly https://localhost:3000 as its task-pane origin.
     Sideload only; this manifest does not install or provision an HTTPS server. -->
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:type="TaskPaneApp">
  <Id>2171917e-21b4-4aba-892a-58b28c7f7652</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>ShiJu</ProviderName>
  <DefaultLocale>zh-CN</DefaultLocale>
  <DisplayName DefaultValue="ShiJu Word 控制"/>
  <Description DefaultValue="在明确批准的临时文档段落内执行读写与回读。"/>
  <IconUrl DefaultValue="https://localhost:3000/office/excel/icon.png"/>
  <SupportUrl DefaultValue="https://github.com/hunzhiwange/shiju/issues"/>
  <Hosts><Host Name="Document"/></Hosts>
  <Requirements>
    <Sets DefaultMinVersion="1.3"><Set Name="WordApi" MinVersion="1.3"/></Sets>
  </Requirements>
  <DefaultSettings>
    <SourceLocation DefaultValue="https://localhost:3000/office/word/taskpane.html"/>
  </DefaultSettings>
  <Permissions>ReadWriteDocument</Permissions>
</OfficeApp>
