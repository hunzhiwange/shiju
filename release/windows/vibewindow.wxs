<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package
    Name="ShiJu"
    UpgradeCode="C8512FCC-FA63-4C65-9458-B5363A71E371"
    Language="1033"
    Codepage="1252"
    Version="{{ .Version }}"
    Manufacturer="ShiJu"
    InstallerVersion="500">
    <SummaryInformation
      Keywords="Installer"
      Description="ShiJu installer"
      Manufacturer="ShiJu" />
    <MajorUpgrade Schedule="afterInstallInitialize" AllowSameVersionUpgrades="yes" DowngradeErrorMessage="A newer version of ShiJu is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <Icon Id="ShiJuIcon" SourceFile="ShiJu.ico" />
    <Property Id="ARPPRODUCTICON" Value="ShiJuIcon" />
    <Property Id="INSTALLFOLDER" Secure="yes" />
    <Property Id="PREVIOUSINSTALLFOLDER">
      <RegistrySearch Id="PreviousInstallLocation" Root="HKLM" Key="Software\ShiJu" Name="InstallLocation" Type="raw" />
    </Property>
    <!-- Keep a directory chosen in the UI or on the command line during execute-sequence AppSearch. -->
    <SetProperty Id="INSTALLFOLDER" Value="[PREVIOUSINSTALLFOLDER]" After="AppSearch" Sequence="both" Condition="PREVIOUSINSTALLFOLDER AND NOT INSTALLFOLDER" />
    <SetProperty Id="ARPINSTALLLOCATION" Value="[INSTALLFOLDER]" After="CostFinalize" Sequence="execute" />

    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <UIRef Id="WixUI_ErrorProgressText" />
    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALTEXT" Value="ShiJu has been installed successfully. Open ShiJu from the desktop or Start menu. To use the shiju command, open a new terminal." />

    <Feature Id="Complete" Title="ShiJu" Level="1">
      <ComponentRef Id="DesktopExecutable" />
      <ComponentRef Id="WebviewHelper" />
      <ComponentRef Id="CliExecutable" />
      <ComponentRef Id="AcpExecutable" />
      <ComponentRef Id="ServiceLauncher" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="DesktopShortcut" />
      <ComponentRef Id="PathEnvironment" />
      <ComponentRef Id="InstallLocation" />
    </Feature>

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="ShiJu">
        <Component Id="DesktopExecutable" Guid="666108C4-9613-4ECD-BA56-CFFD914949AF">
          <File Id="DesktopExecutableFile" Source="{{ .Binary }}.exe" Name="shi-ju.exe" KeyPath="yes" />
        </Component>
        <Component Id="WebviewHelper" Guid="9FDE8ABF-10DA-433A-AECC-5266AA867241">
          <File Id="WebviewHelperFile" Source="vw-webview.exe" Name="vw-webview.exe" KeyPath="yes" />
        </Component>
        <Component Id="CliExecutable" Guid="3807C8BA-FF94-4A72-913F-FD231D29208E">
          <File Id="CliExecutableFile" Source="shiju.exe" Name="shiju.exe" KeyPath="yes" />
        </Component>
        <Component Id="AcpExecutable" Guid="F41598B1-552F-4280-B61B-303E00014B7F">
          <File Id="AcpExecutableFile" Source="acp.exe" Name="acp.exe" KeyPath="yes" />
        </Component>
        <Component Id="ServiceLauncher" Guid="F8D4E515-6923-4080-9B27-387AE4D02369">
          <File Id="ServiceLauncherFile" Source="Start ShiJu Service.cmd" Name="Start ShiJu Service.cmd" KeyPath="yes" />
        </Component>
        <Component Id="PathEnvironment" Guid="7A9F339C-EFD2-4C60-A54B-90BB891E1923" KeyPath="yes">
          <Environment Id="PathEnv" Name="PATH" Value="[INSTALLFOLDER]" Permanent="no" Part="first" Action="set" System="yes" />
        </Component>
        <Component Id="InstallLocation" Guid="DA978BE7-343B-4492-A50C-B8B7904756C0">
          <RegistryValue Root="HKLM" Key="Software\ShiJu" Name="InstallLocation" Type="string" Value="[INSTALLFOLDER]" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder">
      <Component Id="DesktopShortcut" Guid="EC88E535-F182-40E9-A7B4-2A52B0204930">
        <Shortcut
          Id="ShiJuDesktopShortcut"
          Name="ShiJu"
          Description="Open ShiJu"
          Icon="ShiJuIcon"
          Target="[INSTALLFOLDER]shi-ju.exe"
          WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKCU" Key="Software\ShiJu" Name="desktopShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ShiJuProgramMenu" Name="ShiJu">
        <Component Id="StartMenuShortcut" Guid="39676A25-1D3B-4B87-BC17-B5EEAC0BA2F6">
          <Shortcut
            Id="ShiJuShortcut"
            Name="ShiJu"
            Description="Open ShiJu"
            Icon="ShiJuIcon"
            Target="[INSTALLFOLDER]shi-ju.exe"
            WorkingDirectory="INSTALLFOLDER" />
          <Shortcut
            Id="ShiJuServiceShortcut"
            Name="Start ShiJu Service"
            Description="Start the ShiJu service (gateway, channels and scheduler)"
            Icon="ShiJuIcon"
            Target="[INSTALLFOLDER]Start ShiJu Service.cmd"
            WorkingDirectory="INSTALLFOLDER" />
          <RemoveFolder Id="ShiJuProgramMenu" On="uninstall" />
          <RegistryValue Root="HKCU" Key="Software\ShiJu" Name="installed" Type="integer" Value="1" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>
  </Package>
</Wix>
